{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "echo sem-dependencias",
  "buildCommand": "node vercel-publico.mjs",
  "outputDirectory": "publico",
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/dados/:caminho*", "destination": "/api/dados?caminho=:caminho*" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
